# =============================================================
# VARIABLES DE ENTORNO • VIAJES NENA
# Copia este archivo como .env y ajusta los valores correspondientes
# =============================================================

# Clave secreta de Django (Generar una aleatoria en producción)
SECRET_KEY=django-insecure-viajes-nena-demo-key-change-in-production

# Modo depuración (True para desarrollo local, False para producción)
DEBUG=True

# Hosts autorizados (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.29,*

# Puerto de ejecución
PORT=8000

# Base de datos (Opcional si se usa PostgreSQL en lugar de SQLite)
# DATABASE_URL=postgres://usuario:contraseña@servidor:5432/viajesnena

# Zona Horaria
TIME_ZONE=America/Caracas
